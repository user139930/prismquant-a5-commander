# PrismQuant A5 設定範例
# 複製成 .env 後按需要修改。沒有 .env 也能跑（規則模式 + 示例資料）。

# ---------- 服務 ----------
PQ_HOST=127.0.0.1
PQ_PORT=8130
PQ_WEB_BASE_URL=http://127.0.0.1:8130

# ---------- 上游智能體 ----------
PQ_A1_API_URL=http://127.0.0.1:8010
PQ_A2_API_URL=http://127.0.0.1:8120
# A4 未接入就留空：A5 會維持 advisory_only，不產生任何下單指令
PQ_A4_API_URL=
PQ_UPSTREAM_TIMEOUT=4

# ---------- 大腦拓撲 ----------
# rule | shared | lens | split
# rule   = 不呼叫大模型（離線、可重現）
# shared = 全部角色共用一個模型
# lens   = 一個模型 + 分角色溫度（預設）
# split  = 感知層快模型、指揮層強模型
PQ_BRAIN_TOPOLOGY=lens

# 也可以直接在介面「大腦拓撲 → 大模型連線」填，這裡留空即可
PQ_LLM_API_KEY=
PQ_LLM_BASE_URL=https://openrouter.ai/api/v1
PQ_BRAIN_SHARED_MODEL=deepseek/deepseek-chat
PQ_BRAIN_A1_MODEL=deepseek/deepseek-chat
PQ_BRAIN_A2_MODEL=deepseek/deepseek-chat
PQ_BRAIN_A5_MODEL=deepseek/deepseek-chat

# ---------- 提示詞版本 ----------
# v2 = 分層模板（system/role/task/context/contract/guard）+ 記憶與知識庫槽 + 注入隔離
# v1 = 舊版單段模板（留著做對照與回退）
PQ_PROMPT_VARIANT=v2

# ---------- 定時晨報 ----------
# 每天固定時間自動生成並推送；改完不用重啟
PQ_SCHEDULE_ENABLED=false
PQ_SCHEDULE_TIME=08:30
PQ_SCHEDULE_QUESTION=生成今天的晨報

# ---------- Telegram（留空則為預覽模式） ----------
PQ_TELEGRAM_BOT_TOKEN=
PQ_TELEGRAM_CHAT_ID=
PQ_TELEGRAM_WEBHOOK_SECRET=

# ---------- 儲存 ----------
PQ_LEDGER_PATH=data/a5_ledger.db
PQ_BUS_PATH=data/a5_bus.db          # A2A 訊息日誌
PQ_MEMORY_PATH=data/a5_memory.db    # 三層記憶
PQ_RAG_PATH=data/a5_rag.db          # 向量索引
PQ_TOOL_PATH=data/a5_tools.db       # 工具調用審計

# ---------- RAG 向量知識庫 ----------
# local = signed feature hashing + TF-IDF（純標準庫、確定性、零下載；預設）
# api   = 呼叫 OpenAI 兼容 /embeddings（真 embedding，需要 key）
PQ_EMBED_BACKEND=local
PQ_EMBED_MODEL=text-embedding-3-small
PQ_RAG_TOP_K=5
PQ_RAG_SEED_ON_START=true

# ---------- 記憶 ----------
PQ_MEMORY_HALF_LIFE_DAYS=14         # 顯著性半衰期：兩週後權重減半
PQ_MEMORY_RECALL_K=5
