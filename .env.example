# PrismQuant A5 設定範例
# 複製成 .env 後按需要修改。沒有 .env 也能跑（規則模式 + 示例資料）。

# ---------- 服務 ----------
PQ_HOST=127.0.0.1
PQ_PORT=8130
PQ_WEB_BASE_URL=http://127.0.0.1:8130

# ---------- 上游智能體 ----------
PQ_A1_API_URL=http://127.0.0.1:8010
PQ_A2_API_URL=http://127.0.0.1:8120
# A4 未接入就留空：A5 會維持 advisory_only，不產生任何下單指令
PQ_A4_API_URL=
PQ_UPSTREAM_TIMEOUT=4

# ---------- 大腦拓撲 ----------
# rule | shared | lens | split
# rule   = 不呼叫大模型（離線、可重現）
# shared = 全部角色共用一個模型
# lens   = 一個模型 + 分角色溫度（預設）
# split  = 感知層快模型、指揮層強模型
PQ_BRAIN_TOPOLOGY=lens

PQ_LLM_API_KEY=
PQ_LLM_BASE_URL=https://openrouter.ai/api/v1
PQ_BRAIN_SHARED_MODEL=deepseek/deepseek-chat
PQ_BRAIN_A1_MODEL=deepseek/deepseek-chat
PQ_BRAIN_A2_MODEL=deepseek/deepseek-chat
PQ_BRAIN_A5_MODEL=deepseek/deepseek-chat

# ---------- 提示詞版本 ----------
PQ_PROMPT_VARIANT=v1

# ---------- Telegram（留空則為預覽模式） ----------
PQ_TELEGRAM_BOT_TOKEN=
PQ_TELEGRAM_CHAT_ID=
PQ_TELEGRAM_WEBHOOK_SECRET=

# ---------- 儲存 ----------
PQ_LEDGER_PATH=data/a5_ledger.db
